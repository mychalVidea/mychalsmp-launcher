[Desktop Entry]
Name=MYCHAL SMP Launcher
Comment=Oficiální Minecraft launcher sítě MYCHAL SMP s 1-click připojením
Exec=sh -c 'if [ -x "$HOME/.local/share/mychalsmp-launcher/mychalsmp-launcher" ]; then exec "$HOME/.local/share/mychalsmp-launcher/mychalsmp-launcher" --no-sandbox "$@"; elif [ -x "/opt/mychalsmp-launcher/mychalsmp-launcher" ]; then exec "/opt/mychalsmp-launcher/mychalsmp-launcher" --no-sandbox "$@"; else exec mychalsmp-launcher --no-sandbox "$@"; fi' -- %U
Icon=mychalsmp-launcher
Terminal=false
Type=Application
Categories=Game;ActionGame;AdventureGame;
StartupWMClass=xyz.mychalsmp.launcher
MimeType=x-scheme-handler/mychalsmp;text/x-mog;text/plain;application/x-myco-log;text/x-myco;
