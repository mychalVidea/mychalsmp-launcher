{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SMPClient",
  "version": "1.7.6",
  "identifier": "xyz.mychalsmp.launcher",
  "build": {
    "frontendDist": "../src/renderer"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "MYCHAL SMP Launcher",
        "width": 1080,
        "height": 700,
        "minWidth": 980,
        "minHeight": 640,
        "resizable": true,
        "decorations": false,
        "transparent": false,
        "center": true,
        "visible": true,
        "backgroundColor": "#0a0a0c"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "rpm",
      "appimage",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": [
      "../assets/**/*"
    ],
    "copyright": "Copyright © 2026 mychalVidea",
    "category": "Game",
    "shortDescription": "Oficiální Minecraft launcher sítě MYCHAL SMP",
    "fileAssociations": [
      {
        "ext": [
          "mog"
        ],
        "name": "Mychal Log",
        "description": "MYCHAL SMP Log Archive",
        "mimeType": "text/plain",
        "role": "Viewer"
      },
      {
        "ext": [
          "myco"
        ],
        "name": "MYCO Log",
        "description": "MYCHAL SMP Log Archive",
        "mimeType": "text/plain",
        "role": "Viewer"
      }
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0"
        ]
      },
      "rpm": {
        "depends": [
          "webkit2gtk4.1",
          "gtk3"
        ]
      }
    }
  }
}
