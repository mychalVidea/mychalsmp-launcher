{
  "name": "mychalsmp-launcher",
  "version": "1.7.18",
  "description": "Oficiální multiplatformní launcher pro síť MYCHAL SMP s optimalizovaným klientem pro Windows 11 a Linux",
  "scripts": {
    "start": "tauri dev",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "icons:generate": "tauri icon build/icon.png",
    "build:linux": "tauri build --no-bundle",
    "build:win": "tauri build --bundles nsis",
    "build:all": "tauri build",
    "release": "bash release.sh"
  },
  "homepage": "https://mychalsmp.xyz",
  "author": "mychalVidea <admin@mychalsmp.xyz>",
  "license": "MIT",
  "devDependencies": {
    "@tauri-apps/cli": "^2.1.0"
  }
}
